# Supabase project URL. This app uses it only from the server route.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key. Keep this in Vercel Environment Variables only.
# Never prefix it with NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: a separate secret used to hash the anonymous vote cookie.
# If omitted, the service role key is used as the hashing secret.
FACE_VOTE_COOKIE_SECRET=replace-with-a-long-random-secret

# Owner-only comments dashboard password (32+ characters).
# Set this in Vercel Production Environment Variables; do not commit a real password.
FACE_CHECK_ADMIN_PASSWORD=
